# Base URL of the NestJS contact API (the portfolio-api project).
# Local dev default:
VITE_API_BASE=http://localhost:3000
# In production, set this to your deployed API, e.g. https://api.yourdomain.com

# reCAPTCHA v3 site key (public) from https://www.google.com/recaptcha/admin
# Leave unset in local dev to skip reCAPTCHA entirely.
# The matching secret key belongs in the portfolio-api project, not here.
VITE_RECAPTCHA_SITE_KEY=
