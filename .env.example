# ── Frontend (exposed to the browser — must be prefixed VITE_) ──────────
# reCAPTCHA v3 site key (public) from https://www.google.com/recaptcha/admin
# Leave unset in local dev to skip reCAPTCHA entirely.
VITE_RECAPTCHA_SITE_KEY=

# ── api/contact.js serverless function (server-only, never sent to the browser) ──
# Matching reCAPTCHA secret key. Leave unset to disable verification (e.g. local dev).
RECAPTCHA_SECRET_KEY=
# Minimum v3 score (0.0-1.0) to accept a submission. Default 0.5.
RECAPTCHA_MIN_SCORE=0.5

# SMTP transport used to send the contact-form email. Any provider works
# (Amazon SES, Resend, SendGrid, Mailgun, Postmark, Gmail w/ an App Password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false        # true only for port 465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# The "From" the recipient sees. Must be a domain you're allowed to send as.
MAIL_FROM="Portfolio <no-reply@yourdomain.com>"
# Where contact-form messages are delivered.
CONTACT_TO=julio.machaen@gmail.com
